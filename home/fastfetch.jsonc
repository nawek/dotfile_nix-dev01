{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "nixos_small",
        "color": {
            "1": "blue",
            "2": "magenta"
        },
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "title": "magenta"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "  C I T A D E L  ─  {user-name}@{host-name}"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": " OS"
        },
        {
            "type": "kernel",
            "key": " Kernel"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "terminal",
            "key": " Term"
        },
        {
            "type": "shell",
            "key": " Shell"
        },
        {
            "type": "packages",
            "key": "󰏗 Pkgs"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "cpu",
            "key": " CPU"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU"
        },
        {
            "type": "memory",
            "key": "󰑭 RAM"
        },
        {
            "type": "disk",
            "key": " Disk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": " Bat"
        },
        {
            "type": "uptime",
            "key": "󰅐 Up"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
